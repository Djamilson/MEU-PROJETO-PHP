generator client {
  provider = "prisma-client-js"
  output   = "../../../../../prisma/generated/mysql"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_MYSQL_EAS")
}

enum PurchaseStatusEnum {
  AWAITING      @map("awaiting")      // aguardando
  PROCESSING    @map("processing")    // em processamento
  PROCESSED_ALL @map("processed")     // processado
}

enum GroupsNameEnum {
  ROLE_SUPER_ADMIN @map("role-super-admin")
  ROLE_ADMIN       @map("role-admin")
  ROLE_USER        @map("role-user")
  ROLE_CLIENT      @map("role-client")
}

model Car {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  name       String   @db.VarChar(255)
  prefix     String   @db.VarChar(50)

  scaleCar   ScaleCar[] @relation("car")

  @@index([id])
  @@map("cars")
}

model Scale {
  id          String             @id @default(cuid())
  created_at  DateTime           @default(now())
  updated_at  DateTime           @default(now())
  canceled_at DateTime?
  name        String             @db.VarChar(255)
  date        DateTime
  status      PurchaseStatusEnum @default(AWAITING)

  scaleCar    ScaleCar[] @relation("scale")

  @@index([id])
  @@map("scales")
}

model PostGrad {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  name       String   @db.VarChar(255)
  sigla      String   @db.VarChar(255)

  PersonPostGrad PersonPostGrad[] @relation("PostGrad")

  @@index([id])
  @@map("post_grad")
}

model ScaleCar {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  car_id String
  car    Car    @relation("car", fields: [car_id], references: [id], map: "scale_car_car_id_fkey")

  scale_id String
  scale    Scale  @relation("scale", fields: [scale_id], references: [id], map: "scale_car_scale_id_fkey")

  // pivot correto com usuários
  scale_car_user ScaleCarUser[]

  @@index([id, car_id])
  @@map("scales_cars")
}

model ScaleCarUser {
  id           String   @id @default(cuid())
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())

  scale_car_id String
  scale_car    ScaleCar @relation(fields: [scale_car_id], references: [id], map: "scale_car_user_scale_car_id_fkey")

  user_id      String
  user         User     @relation(fields: [user_id], references: [id], map: "scale_car_user_user_id_fkey")

  @@unique([user_id, scale_car_id]) // evita duplicatas do mesmo user no mesmo scale_car
  @@index([id])
  @@map("scales_cars_users")
}

model Group {
  id          String      @id @default(cuid())
  created_at  DateTime    @default(now())
  updated_at  DateTime    @default(now())
  name        String      @db.VarChar(255)
  description String
  user_group  UserGroup[]

  @@index([id])
  @@map("groups")
}

model Person {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  name       String   @db.VarChar(255)

  current_grad_id String?          @unique
  current_grad    PersonPostGrad?  @relation("CurrentGrad", fields: [current_grad_id], references: [id])

  users          User[]
  person_post_grad PersonPostGrad[] // lado oposto não usa `map` no @relation

  @@index([id])
  @@map("persons")
}

model PersonPostGrad {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  post_grad_id String
  post_grad        PostGrad @relation("PostGrad", fields: [post_grad_id], references: [id], map: "person_pos_grad_id_fkey")

  person_id   String
  person      Person @relation(fields: [person_id], references: [id], map: "person_post_grad_id_fkey")

  // relação inversa da "graduação atual"
  current_of      Person?  @relation("CurrentGrad")

  @@index([id, person_id, post_grad_id])
  @@map("persons_posts_grads")
}

model UserGroup {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  status   Boolean @default(true)
  group_id String
  user_id  String

  group Group @relation(fields: [group_id], references: [id], map: "user_group_group_id_fkey")
  user  User  @relation(fields: [user_id], references: [id], map: "user_group_user_id_fkey")

  @@id([user_id, group_id])
  @@index([user_id, group_id])
  @@map("users_groups")
}

model User {
  id           String      @id @default(cuid())
  created_at   DateTime    @default(now())
  updated_at   DateTime    @default(now())
  password     String?
  is_verified  DateTime?
  person_id    String?
  person       Person?     @relation(fields: [person_id], references: [id], map: "user_person_id_fkey")

  users_groups UserGroup[]
  accounts     Account[]
  sessions     Session[]
  ScaleCarUser ScaleCarUser[]

  @@index([id, person_id])
  @@map("users")
}

model Account {
  id                  String @id @default(cuid())
  user_id             String
  type                String
  provider            String
  provider_account_id String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "account_user_id_fkey")

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("accounts")
}

model Session {
  session_token String   @unique
  user_id       String
  expires       DateTime

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "session_user_id_fkey")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@map("sessions")
}

model RegisterUser {
  id              String   @id @default(cuid())
  code_validation String   @unique
  email           String
  expires         DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([id])
  @@map("registers_users")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@index([id, email, token])
  @@map("verifications_tokens")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@index([id])
  @@map("passwords_reset_tokens")
}
